# ==========================================
# VestiAI - Git Ignore Configuration
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
apps/api/venv/
.venv

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# AI Model Checkpoints & Large Weights
checkpoints/
weights/
models_cache/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.engine
*.ckpt
*.h5
openpose/
densepose/

# Datasets & Training Data
datasets/
data/
VITON-HD/
DressCode/
*.zip
*.tar.gz
*.tar

# User Uploads & Generated Media (Private storage)
uploads/
user-uploads/
tryon-results/
storage_data/
storage_data/*
!storage_data/.gitkeep
temp/
*.tmp

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
apps/web/dist/
apps/web/dist-ssr/
.vite/
*.tsbuildinfo

# IDE & OS Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Logs
logs/
*.log

