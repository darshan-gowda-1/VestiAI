# ==============================================================================
# VestiAI Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your local environment.
# DO NOT COMMIT REAL SECRETS, TOKENS, OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=True
APP_NAME="VestiAI Virtual Try-On API"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# --- Frontend Settings ---
# URL where Vite frontend can reach the backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Security & Authentication ---
# Generate a strong key using: openssl rand -hex 32
AUTH_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Cross-Origin Resource Sharing (CORS) ---
# JSON array of origins permitted to access the backend API
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# --- Database (PostgreSQL) ---
# Async URL for FastAPI SQLAlchemy async engine
DATABASE_URL=postgresql+asyncpg://vestiai_user:vestiai_password@localhost:5432/vestiai_db
# Sync URL used by Alembic migrations
SYNC_DATABASE_URL=postgresql://vestiai_user:vestiai_password@localhost:5432/vestiai_db

# --- Background Task Queue (Redis + Celery/RQ) ---
REDIS_URL=redis://localhost:6379/0

# --- Media Storage Configuration ---
# Options: 'local' for development, 's3' for production S3-compatible object storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage_data

# S3 Configuration (Used only when STORAGE_BACKEND=s3)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=vestiai-media-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key_placeholder
S3_SECRET_KEY=your_s3_secret_key_placeholder

# Media Limits & Retention
UPLOAD_MAX_MB=10
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
RESULT_RETENTION_DAYS=7

# --- AI Virtual Try-On Model Configuration ---
# Candidate models: 'idm-vton' or 'catvton'
MODEL_NAME=idm-vton
# Device options: 'cuda' (NVIDIA GPU, recommended), 'cpu' (fallback/testing)
MODEL_DEVICE=cuda
MODEL_PRECISION=fp16
MODEL_CHECKPOINT_DIR=./checkpoints
INFERENCE_STEPS=30
INFERENCE_TIMEOUT_SECONDS=120

